<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      亮色主题语义色 — 权威来源：docs/mockups/VisionBench-主窗体-亮色配色.html
      大面积灰阶分层；彩色仅用于交互与结果。
    -->

    <!-- 表面 -->
    <Color x:Key="AppColor">#F4F6F9</Color>
    <Color x:Key="WinTitleColor">#CBD5E1</Color>
    <Color x:Key="WinButtonColor">#CBD5E1</Color>
    <Color x:Key="MenuContainerColor">#475569</Color>
    <Color x:Key="MenuHoverColor">#DCE8F8</Color>
    <Color x:Key="IconButtonHoverColor">#DCE8F8</Color>

    <!-- 边框 -->
    <Color x:Key="BorderColor">#D5DEE9</Color>
    <Color x:Key="BorderStrongColor">#B8C5D6</Color>

    <!-- 文字 -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextTertiaryColor">#64748B</Color>
    <Color x:Key="TextDisabledColor">#94A3B8</Color>
    <Color x:Key="WinTitleFontColor">#0F172A</Color>
    <Color x:Key="MenuFontColor">#EEF2F7</Color>
    <Color x:Key="MenuHoverFontColor">#2B6CB0</Color>

    <!-- 强调 -->
    <Color x:Key="AccentColor">#2B6CB0</Color>
    <Color x:Key="AccentHoverColor">#245A96</Color>
    <Color x:Key="AccentSoftColor">#DBEAFE</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- 结果语义 -->
    <Color x:Key="SuccessColor">#0D9488</Color>
    <Color x:Key="SuccessSoftColor">#CCFBF1</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSoftColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEE2E2</Color>

    <!-- 图像区（唯一深色例外） -->
    <Color x:Key="VisionBackgroundColor">#12161C</Color>
    <Color x:Key="VisionLabelColor">#94A3B8</Color>


    <!-- 画笔 -->
    <SolidColorBrush x:Key="AppBrush" Color="{StaticResource AppColor}"/>
    <SolidColorBrush x:Key="WinTitleBrush" Color="{StaticResource WinTitleColor}"/>
    <SolidColorBrush x:Key="WindowTitleBrush" Color="{StaticResource WinTitleColor}"/>
    <SolidColorBrush x:Key="WindowButtonBrush" Color="{StaticResource WinButtonColor}"/>
    <SolidColorBrush x:Key="WindowButtonFontBrush" Color="{StaticResource WinButtonColor}"/>
    <SolidColorBrush x:Key="WindowButtonHoverFontBrush" Color="{StaticResource WinButtonColor}"/>
    <SolidColorBrush x:Key="WindowHoverBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WinTitleFontBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="MenuContainerBrush" Color="{StaticResource MenuContainerColor}"/>
    <SolidColorBrush x:Key="MenuFontBrush" Color="{StaticResource MenuFontColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="MenuHoverFontBrush" Color="{StaticResource MenuHoverFontColor}"/>
    <SolidColorBrush x:Key="IconButtonHoverBrush" Color="{StaticResource IconButtonHoverColor}"/>

    <system:Double x:Key="AppFontSize">12</system:Double>
</ResourceDictionary>
