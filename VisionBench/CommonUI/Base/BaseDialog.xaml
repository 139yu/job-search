<Window x:Class="CommonUI.Base.BaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:CommonUI.Base"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True" Background="Transparent"
        FontSize="{DynamicResource AppFontSize}"
        Title="DialogWindow" MinHeight="200" MinWidth="300">
 
    <Grid Margin="10" Background="Transparent">
        <Border CornerRadius="10" BorderThickness="0" Background="{DynamicResource AppBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="28" Opacity="0.3" RenderingBias="Quality"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource WindowTitleBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Border Margin="10,0,0,0">
                        <Image Source="{StaticResource Logo}" Width="30" Height="30">
                            <Image.Clip>
                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <TextBlock Margin="10,0,0,0" Grid.Column="1" 
                               VerticalAlignment="Center" 
                               Text="{Binding DataContext.Title}"/>
                    <Button Grid.Column="2" Style="{StaticResource WinTitleButtonStyle}" Click="MinimizeClick">
                        <Button.Content>
                            <Viewbox Width="30" Height="30">
                                <Border Width="20" Height="20">
                                    <Path Data="M 4,10 L 16,10" StrokeThickness="1.5" Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                                </Border>
                            </Viewbox>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource WinTitleButtonStyle}" Click="CloseDialogClick">
                        <Button.Content>
                            <Viewbox Width="30" Height="30">
                                <Border Width="20" Height="20">
                                    <Path Data="M 5,5 L 15,15 M 15,5 L 5,15" StrokeThickness="1.2" Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                                </Border>
                            </Viewbox>
                        </Button.Content>
                    </Button>
                </Grid>
                <Grid Background="{DynamicResource AppBrush}" Grid.Row="1">
                    <ContentControl x:Name="DialogContentHost"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
