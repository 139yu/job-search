<UserControl x:Class="MainApp.Views.Menu.CameraSettingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:MainApp.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             x:Name="win"
             Foreground="{DynamicResource SecondaryTextBrush}"
             FontSize="{DynamicResource AppFontSize}"
             Width="900" Height="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter  x:Key="BoolToV"/>
        <Style TargetType="TextBlock" x:Key="ListTitleTextStyle">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ListItemTextStyle">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource AppBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Border Padding="10" Grid.Row="0" Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="工位" Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center" />
                <ListBox Background="{DynamicResource PanelBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemsSource="{Binding StationList}"
                         SelectedItem="{Binding SelectedStation}"
                         Grid.Row="1" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border HorizontalAlignment="Stretch" Padding="{TemplateBinding Padding}"
                                                x:Name="root"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                            <ContentPresenter x:Name="content" Grid.Column="1"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="root" Property="Background"
                                                        Value="{DynamicResource ItemSelectedBrush}" />
                                                <Setter TargetName="content" Property="TextBlock.FontWeight"
                                                        Value="Bold" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="root" Property="Background"
                                                        Value="{DynamicResource ItemMouseOverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer Focusable="False" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="5">
                                <Grid HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="icon" Margin="0,0,5,0"
                                                Width="10" Height="10"
                                                CornerRadius="10"
                                                Background="{DynamicResource UnbindBrush}" />
                                        <TextBlock Text="{Binding StationName}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <TextBlock x:Name="bindTxt" Visibility="Collapsed"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Text="已绑定" />
                                    <TextBlock x:Name="unBindTxt"
                                               Visibility="Visible" FontSize="{DynamicResource SmallFontSize}"
                                               Foreground="{DynamicResource UnbindBrush}"
                                               VerticalAlignment="Center" FontWeight="Normal"
                                               HorizontalAlignment="Right" Text="未绑定" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBound}" Value="True">
                                    <Setter TargetName="bindTxt" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="icon" Property="Background"
                                            Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="unBindTxt" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Margin="10" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Padding="10" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="36" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Border Width="3" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="相机绑定" VerticalAlignment="Center"
                                   FontSize="{DynamicResource SecondaryFontSize}"
                                   FontWeight="Black" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                        <hc:ComboBox ItemsSource="{Binding CameraBrands}" 
                                     VerticalAlignment="Center" 
                                     DisplayMemberPath="CameraName"
                                     SelectedItem="{Binding SelectedCameraBrand,Mode=TwoWay}"
                                     hc:TitleElement.TitlePlacement="Left" 
                                     hc:TitleElement.Title="品牌" Width="260" 
                                     hc:TitleElement.TitleWidth="60" />
                        <Button Content="枚举相机" 
                                Command="{Binding FindCameraCommand}"
                                Style="{StaticResource ButtonPrimary}" Margin="10,0"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="序列号" Style="{StaticResource ListTitleTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="型号" Style="{StaticResource ListTitleTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="连接" Style="{StaticResource ListTitleTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource ListTitleTextStyle}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Grid.ColumnSpan="6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"></Border>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CameraItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource ListItemTextStyle}" Text="{Binding Camera.SerialNum}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource ListItemTextStyle}" Text="{Binding Camera.TypeModel}"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource ListItemTextStyle}" Text="{Binding Camera.InterfaceType}"/>
                                        <Button Grid.Column="3" Content="绑定"   HorizontalAlignment="Center"
                                                Height="30" Visibility="{Binding ShowBindButton,Converter={StaticResource BoolToV}}"
                                                Command="{Binding DataContext.BindCameraCommand, 
                                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                Style="{StaticResource ButtonPrimary}" 
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="3" Content="解绑" HorizontalAlignment="Center"
                                                Height="30" Visibility="{Binding ShowUnBindButton,Converter={StaticResource BoolToV}}"
                                                Command="{Binding DataContext.UnBindCameraCommand, 
                                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                                Style="{StaticResource ButtonInfo}" 
                                                CommandParameter="{Binding}"/>
                                        <Border Height="1" 
                                                VerticalAlignment="Bottom" 
                                                Grid.ColumnSpan="6" 
                                                BorderThickness="0,0,0,1" 
                                                BorderBrush="{DynamicResource BorderBrush}"></Border>
                                    </Grid>
                                    
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
            <Border Margin="0,10,0,0" Grid.Row="1"  Padding="10" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Border Width="3" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="相机参数" VerticalAlignment="Center"
                                   FontSize="{DynamicResource SecondaryFontSize}"
                                   FontWeight="Black" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="翻转" Width="80" VerticalAlignment="Center"/>
                        <ToggleButton IsChecked="{Binding SelectedStation.CameraParam.ReverseX}" 
                                      Content="水平翻转" Margin="0,0,10,0" Style="{StaticResource ToggleButtonSwitch}"/>
                        <ToggleButton IsChecked="{Binding SelectedStation.CameraParam.ReverseY}" 
                                      Content="垂直翻转" Style="{StaticResource ToggleButtonSwitch}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="曝光" Width="80" VerticalAlignment="Center"/>
                        <hc:PreviewSlider Value="{Binding SelectedStation.CameraParam.ExposureTime}" Width="300" Maximum="100000">
                            <hc:PreviewSlider.PreviewContent>
                                <Label Style="{StaticResource LabelPrimary}" Content="{Binding Path=(hc:PreviewSlider.PreviewPosition),RelativeSource={RelativeSource Self}}" ContentStringFormat="#0.00"/>
                            </hc:PreviewSlider.PreviewContent>
                        </hc:PreviewSlider>
                        <hc:TextBox Text="{Binding SelectedStation.CameraParam.ExposureTime}" 
                                    VerticalAlignment="Center" Width="60" Margin="10,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <TextBlock Text="增益" Width="80" VerticalAlignment="Center"/>
                        <hc:PreviewSlider Value="{Binding SelectedStation.CameraParam.Gain}" Width="300" Maximum="12">
                            <hc:PreviewSlider.PreviewContent>
                                <Label Style="{StaticResource LabelPrimary}" Content="{Binding Path=(hc:PreviewSlider.PreviewPosition),RelativeSource={RelativeSource Self}}" ContentStringFormat="#0.00"/>
                            </hc:PreviewSlider.PreviewContent>
                        </hc:PreviewSlider>
                        <hc:TextBox Text="{Binding SelectedStation.CameraParam.Gain}" VerticalAlignment="Center" Width="60" Margin="10,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <TextBlock Text="分辨率" Width="80" VerticalAlignment="Center"/>
                        <hc:TextBox Width="60" VerticalAlignment="Center"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="5,0"/>
                        <hc:TextBox Width="60" VerticalAlignment="Center"/>
                        <TextBlock Text="宽×高" VerticalAlignment="Center" FontSize="{DynamicResource SmallFontSize}"
                                   Foreground="{DynamicResource ThirdlyTextBrush}" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                        <TextBlock Text="像元尺寸" Width="80" VerticalAlignment="Center"/>
                        <hc:TextBox VerticalAlignment="Center" Text="{Binding SelectedStation.CameraParam.PixelSize}" Width="60" Margin="0,0,5,0"/>
                        <TextBlock Text="μm" Width="80" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}">
            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" Width="80" Content="保存" 
                    VerticalAlignment="Center" Margin="0,0,20,0"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>