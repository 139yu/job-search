<Window x:Class="CommonUI.Base.BaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converter="clr-namespace:CommonUI.Converters"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:CommonUI.Base"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True" Background="Transparent"
        FontSize="{DynamicResource AppFontSize}"
        SizeToContent="WidthAndHeight"
        Title="DialogWindow" MinHeight="200" MinWidth="300">
    <Window.Resources>
        <converter:RectConverter x:Key="RectConverter"></converter:RectConverter>
    </Window.Resources>
    <Border>
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="10" Opacity="0.5" RenderingBias="Quality" />
        </Border.Effect>
        <Grid Margin="32">
            <Border x:Name="RootBorder" CornerRadius="10" BorderThickness="0" Background="{DynamicResource AppBrush}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10">
                        <RectangleGeometry.Rect>
                            <MultiBinding Converter="{StaticResource RectConverter}">
                                <Binding Path="ActualWidth" ElementName="RootBorder"/>
                                <Binding Path="ActualHeight" ElementName="RootBorder"/>
                            </MultiBinding>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </Border.Clip>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{DynamicResource WindowTitleBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="10,0,0,0">
                            <Image Source="{StaticResource Logo}" Width="30" Height="30">
                                <Image.Clip>
                                    <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Margin="10,0,0,0" Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding DataContext.Title}" />
                        <Button Grid.Column="2" Style="{StaticResource WinTitleButtonStyle}" Click="MinimizeClick">
                            <Button.Content>
                                <Viewbox Width="30" Height="30">
                                    <Border Width="20" Height="20">
                                        <Path Data="M 4,10 L 16,10" StrokeThickness="1.5"
                                      Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}" />
                                    </Border>
                                </Viewbox>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource WinTitleButtonStyle}" Click="CloseDialogClick">
                            <Button.Content>
                                <Viewbox Width="30" Height="30">
                                    <Border Width="20" Height="20">
                                        <Path Data="M 5,5 L 15,15 M 15,5 L 5,15" StrokeThickness="1.2"
                                      Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}" />
                                    </Border>
                                </Viewbox>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <Grid Background="{DynamicResource AppBrush}" Grid.Row="1">
                        <ContentControl x:Name="DialogContentHost" />
                        <ScrollViewer Panel.ZIndex="1000" 
                              VerticalScrollBarVisibility="Hidden" 
                              HorizontalScrollBarVisibility="Disabled" 
                              IsHitTestVisible="False"
                              Margin="0,10,0,0"
                              HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Panel.ZIndex="9999"  hc:Growl.Token="DialogTop" VerticalAlignment="Top"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
    
</Window>