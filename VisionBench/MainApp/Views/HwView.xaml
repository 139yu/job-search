<UserControl x:Class="MainApp.Views.HwView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:MainApp.Views"
             xmlns:commonUi="clr-namespace:CommonUI;assembly=CommonUI"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
             xmlns:components="clr-namespace:CommonUI.Components;assembly=CommonUI"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             FontSize="{DynamicResource AppFontSize}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <components:IconButton Height="50" Command="{Binding OpenImageCommand}" 
                                   Content="打开图片" 
                                 IconCode="&#xe621;" 
                                 IconSize="16"/>
            <components:IconButton Height="50" Command="{Binding SaveImageCommand}" 
                                   Content="保存图片" 
                                   IconCode="&#xec09;" 
                                   IconSize="16"/>
        </StackPanel>
        <halcon:HSmartWindowControlWPF AutomationProperties.AutomationId="btn" Grid.Column="1" x:Name="HalconWindow"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5,10">
            <Border BorderThickness="1" Background="#990F172A" VerticalAlignment="Center" Opacity="0.6"
                    BorderBrush="#5594A3B8" 
                    CornerRadius="5" IsHitTestVisible="False" Padding="8,4">
                <StackPanel Orientation="Horizontal" TextBlock.FontSize="{DynamicResource SmallFontSize}" TextBlock.Foreground="{DynamicResource HalconToolForeground}">
                    <TextBlock VerticalAlignment="Center" Text="X:"/>
                    <TextBlock VerticalAlignment="Center" Width="40" Text="-"/>
                    <TextBlock VerticalAlignment="Center" Text="Y:"/>
                    <TextBlock VerticalAlignment="Center" Width="40" Text="-"/>
                    <TextBlock VerticalAlignment="Center" Text="Gray:"/>
                    <TextBlock VerticalAlignment="Center" Width="40" Text="-"/>
                </StackPanel>
            </Border>
            <Button Width="20" Height="20" Margin="10,0,0,0">
                <Button.Content>
                    <TextBlock Text="&#xe657;" 
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource HalconToolForeground}" 
                               FontFamily="{DynamicResource IconFont}"/>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="1" BorderBrush="#5594A3B8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
