<Window x:Class="MainApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainApp"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:commons="clr-namespace:Commons;assembly=Commons"
        xmlns:commonUI="clr-namespace:CommonUI.Helper;assembly=CommonUI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" FontSize="{DynamicResource AppFontSize}"
        WindowStyle="None" SnapsToDevicePixels="True"
        Background="{DynamicResource AppBrush}"
        Title="{Binding Title}" Height="900" Width="1600">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"></WindowChrome>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.6*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <!--头部-->
        <Grid  Grid.Row="0" Grid.Column="0" 
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource WindowTitleBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" Margin="10,0,0,0"
                    BorderBrush="{DynamicResource WindowTitleBrush}" 
                    ClipToBounds="True">
                <Image Source="{StaticResource Logo}" Stretch="UniformToFill">
                    <Image.Clip>
                        <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                    </Image.Clip>
                </Image>
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryForeground}" 
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Grid.Column="2" Style="{StaticResource WinTitleButtonStyle}" Click="MinimizeClick">
                <Button.Content>
                    <Viewbox Width="30" Height="30">
                        <Border Width="20" Height="20">
                            <Path Data="M 4,10 L 16,10" StrokeThickness="1.5" Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                        </Border>
                    </Viewbox>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource WinTitleButtonStyle}" Click="MaxClick" x:Name="MaxBtn">
                <Button.Content>
                    <Viewbox Width="30" Height="30">
                        <Border Width="20" Height="20">
                            <Path Data="M 5,5 15,5 15,15 5,15 5,5" StrokeThickness="1" 
                                  Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                        </Border>
                    </Viewbox>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource WinTitleButtonStyle}" Click="NormalClick" x:Name="NormalBtn">
                <Button.Content>
                    <Viewbox Width="30" Height="30">
                        <Border Width="20" Height="20">
                            <Path Data="m 10,8 0 -2 8,0 0,8 -2,0 0,-6 -10,0 0,8 10,0 0,-2" StrokeThickness="1"
                                  Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                        </Border>
                    </Viewbox>
                </Button.Content>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource WinTitleButtonStyle}" Command="{Binding CloseCommand}">
                <Button.Content>
                    <Viewbox Width="30" Height="30">
                        <Border Width="20" Height="20">
                            <Path Data="M 5,5 L 15,15 M 15,5 L 5,15" StrokeThickness="1.2" Stroke="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Button},Path=Foreground}"/>
                        </Border>
                    </Viewbox>
                </Button.Content>
            </Button>
        </Grid>
        <!--菜单区域-->
        <Border  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource MenuContainerBrush}" >
            <ContentControl prism:RegionManager.RegionName="{x:Static commons:RegionConstants.MainMenuRegion}"/>
        </Border>
        <!--左侧区域-->
        <Grid Grid.Row="2" Grid.Column="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="10" HorizontalAlignment="Right" Width="1" Background="{DynamicResource BorderBrush}"/>
            <StackPanel Grid.Row="0" Background="{DynamicResource WindowTitleBrush}"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Stretch">
                <Border Width="3" Height="14" VerticalAlignment="Center" Margin="10,0,5,0"
                        Background="{DynamicResource AccentBrush}" />
                <TextBlock Text="相机绑定" VerticalAlignment="Center"
                        FontSize="{DynamicResource SecondaryFontSize}"
                        FontWeight="Black" />
            </StackPanel>
            <Border Margin="10" Padding="10" Grid.Row="1" Background="{DynamicResource PanelBrush}"
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="10" Height="10" CornerRadius="5"
                                commonUI:BoolDynamicBrush.Flag="{Binding CameraConnected}"
                                commonUI:BoolDynamicBrush.BgTrueKey="SuccessBrush"
                                commonUI:BoolDynamicBrush.BgFalseKey="FailedBrush"
                                VerticalAlignment="Center" Margin="00,0,5,0"/>
                        <TextBlock Grid.Column="1"  Text="{Binding MainStation.StationName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" 
                                   HorizontalAlignment="Right" Margin="0,0,0,0"
                                   commonUI:BoolDynamicBrush.Flag="{Binding CameraConnected}"
                                   commonUI:BoolDynamicBrush.FgTrueKey="SuccessBrush"
                                   commonUI:BoolDynamicBrush.FgFalseKey="FailedBrush"
                                   Text="{Binding ConnectionStateText}"/>
                        
                    </Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <TextBlock VerticalAlignment="Center" 
                            Foreground="{DynamicResource SecondaryForeground}" 
                            Text="分辨率" Margin="0,0,5,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding MainStation.CameraParam.ImageWidth}" />
                        <TextBlock VerticalAlignment="Center" Text="x" Margin="2,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding MainStation.CameraParam.ImageHeight}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="采集控制" FontWeight="ExtraBold"
                       Foreground="{DynamicResource SecondaryForeground}" 
                       Margin="10,0,0,0"/>
            <Border Grid.Row="3" BorderThickness="1" Padding="10"
                    BorderBrush="{DynamicResource BorderBrush}" 
                    Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Stretch" 
                            Content="开始采集" 
                            Style="{StaticResource ButtonPrimary}"/>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" 
                            Margin="0,10" Content="单帧采集" 
                            Style="{StaticResource ButtonDefault}"/>
                    <TextBlock VerticalAlignment="Center" Grid.Row="2">
                        <Run Text="FPS" Foreground="{DynamicResource SecondaryForeground}"/>
                        <Run Text="{Binding MainStation.CameraParam.Fps}"/>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="相机参数·实时调整" FontWeight="ExtraBold"
                       Foreground="{DynamicResource SecondaryForeground}" 
                       Margin="10,0,0,0"/>
            <StackPanel Grid.Row="5" Orientation="Vertical" Margin="10,0">
                <Grid Height="28">
                    <TextBlock Text="曝光时间" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding MainStation.CameraParam.ExposureTime}" 
                               VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Run Text="{Binding MainStation.CameraParam.ExposureTime}" />
                        <Run Text=" μm"/>
                    </TextBlock>
                </Grid>
                <hc:PreviewSlider Height="28" Value="{Binding MainStation.CameraParam.ExposureTime}" Maximum="100000">
                    <hc:PreviewSlider.PreviewContent>
                        <Label Style="{StaticResource LabelPrimary}" Content="{Binding Path=(hc:PreviewSlider.PreviewPosition),RelativeSource={RelativeSource Self}}" ContentStringFormat="#0.00"/>
                    </hc:PreviewSlider.PreviewContent>
                </hc:PreviewSlider>
            </StackPanel>
            <StackPanel Grid.Row="6" Orientation="Vertical" Margin="10,0">
                <Grid Height="28">
                    <TextBlock Text="增益" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding MainStation.CameraParam.Gain}" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <hc:PreviewSlider Height="28" Value="{Binding MainStation.CameraParam.ExposureTime}" Maximum="100000">
                    <hc:PreviewSlider.PreviewContent>
                        <Label Style="{StaticResource LabelPrimary}" Content="{Binding Path=(hc:PreviewSlider.PreviewPosition),RelativeSource={RelativeSource Self}}" ContentStringFormat="#0.00"/>
                    </hc:PreviewSlider.PreviewContent>
                </hc:PreviewSlider>
            </StackPanel>
        </Grid>
        <!--Halcon 窗口-->
        <ContentControl  Grid.Row="2" Grid.Column="1" prism:RegionManager.RegionName="{x:Static commons:RegionConstants.HalconRegion}"/>
        
        <!--motion区域-->
        <Grid Grid.Row="3" Grid.Column="1" Grid.RowSpan="1" Background="BlueViolet"></Grid>
        <!--右侧区域-->
        <Grid Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Background="DeepSkyBlue"></Grid>
        <!--Handy Control Growl容器-->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="5" Grid.ColumnSpan="10" Panel.ZIndex="1000" 
                      VerticalScrollBarVisibility="Hidden" 
                      HorizontalScrollBarVisibility="Disabled" 
                      IsHitTestVisible="False"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Panel.ZIndex="9999"  hc:Growl.Token="MainTop" VerticalAlignment="Top"/>
        </ScrollViewer>
        
    </Grid>
</Window>
