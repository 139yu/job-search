<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CommonUI">
    <Style TargetType="local:IconButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IconButton">
                    <Border x:Name="root" Background="{TemplateBinding Background}"
                            Padding="0,8"
                            IsHitTestVisible="True"
                            Width="{TemplateBinding Width}" 
                            Height="{TemplateBinding Height}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="{TemplateBinding IconSize}"
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,5"
                                       Text="{TemplateBinding IconCode}"
                                       Foreground="{TemplateBinding IconBrush}"/>
                            <ContentPresenter TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource IconButtonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
