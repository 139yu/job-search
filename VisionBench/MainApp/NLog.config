<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/logs/internal-nlog.txt">
    <!-- 调试开关：Off=生产；Debug 构建由 App.xaml.cs 启动时改成 Debug -->
    <variable name="debugLevel" value="Off" />

    <!--
        ${basedir} = 可执行文件目录，WPF 桌面程序日志统一落 exe 目录/logs/。
        ${shortdate} 按天滚动；archiveAboveSize + maxArchiveFiles 控制体积。
        ${logger} 日志类别
    -->
    <targets async="true">
        <target xsi:type="File" name="functionalFile"
                fileName="${basedir}/logs/Normal/${event-properties:item=Module:whenEmpty=Other}/${shortdate}.log"
                layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
                archiveFileName="${basedir}/logs/Normal/${event-properties:item=Module:whenEmpty=Other}/${shortdate}.{#####}.log"
                archiveAboveSize="10485760" maxArchiveFiles="30" archiveNumbering="Sequence"
                encoding="utf-8" />
        <target xsi:type="File" name="errorFile"
                fileName="${basedir}/logs/Errors/errors-${shortdate}.log"
                layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
                archiveFileName="${basedir}/logs/Errors/errors-${shortdate}.{#####}.log"
                archiveAboveSize="10485760" maxArchiveFiles="30" archiveNumbering="Sequence"
                encoding="utf-8" />
        <target xsi:type="Debugger" name="debugger" layout="${time} ${level:uppercase=true} ${logger} - ${message}" />
        <target xsi:type="File" name="debugFile"
                fileName="${basedir}/logs/Debug/debug-${shortdate}.log"
                layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

    </targets>

    <rules>
        <logger name="*" minlevel="Info" maxlevel="Warn" writeTo="functionalFile" />
        <logger name="*" minlevel="Error" writeTo="errorFile" />
        <logger name="*" minlevel="${var:debugLevel}" writeTo="debugger,debugFile" />

    </rules>

</nlog>